# Copie para .env e ajuste os valores. O .env NUNCA vai para o git.

# Banco de dados
DB_NAME=mesamar
DB_USER=mesamar
DB_PASSWORD=troque-esta-senha
# Em produção, a URL completa do JDBC:
DB_URL=jdbc:postgresql://db:5432/mesamar

# Perfil do Spring: local | prod
SPRING_PROFILES_ACTIVE=local

# Site público (landing)
# URL pública sem barra no final (usada em canonical, Open Graph e sitemap)
MESAMAR_PUBLIC_URL=http://localhost:8080
# WhatsApp do botão "Falar no WhatsApp": só dígitos, 55 + DDD + número. Vazio esconde o botão.
MESAMAR_WHATSAPP=
# E-mail para pedidos de privacidade (LGPD). Opcional.
MESAMAR_CONTACT_EMAIL=
# Token do Cloudflare Web Analytics (sem cookies). Vazio desativa.
MESAMAR_CF_ANALYTICS_TOKEN=
# Cloudflare Turnstile (anti-robô do formulário da lista de espera). Vazio = desligado.
MESAMAR_TURNSTILE_SITE_KEY=
MESAMAR_TURNSTILE_SECRET_KEY=
