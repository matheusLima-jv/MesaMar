# Copie para .env e ajuste os valores. O .env NUNCA vai para o git.

# Banco de dados
DB_NAME=mesamar
DB_USER=mesamar
DB_PASSWORD=troque-esta-senha
# Produção usa contas separadas e o compose próprio: consulte deploy/prod.env.example.
# No compose local, esta conta também executa migrações.
# URL completa do JDBC:
DB_URL=jdbc:postgresql://db:5432/mesamar

# Perfil do Spring: local | prod
SPRING_PROFILES_ACTIVE=local

# Site público (landing)
# URL pública sem barra no final (usada em canonical, Open Graph e sitemap)
MESAMAR_PUBLIC_URL=http://localhost:8080
# WhatsApp do botão "Falar no WhatsApp": só dígitos, 55 + DDD + número. Vazio esconde o botão.
MESAMAR_WHATSAPP=
# E-mail para pedidos de privacidade (LGPD). Opcional.
MESAMAR_CONTACT_EMAIL=
# Token do Cloudflare Web Analytics (sem cookies). Vazio desativa.
MESAMAR_CF_ANALYTICS_TOKEN=
# Cloudflare Turnstile (anti-robô do formulário da lista de espera). Vazio = desligado.
MESAMAR_TURNSTILE_SITE_KEY=
MESAMAR_TURNSTILE_SECRET_KEY=
# Painel /admin (lista de espera e medições). Sem senha, o painel fica trancado.
# Web Push (avisos de pedido com o app fechado). Gere o par UMA vez, no seu computador:
#   ./gradlew --console=plain -q :backend:gerarVapid
# A chave PRIVADA é segredo: só aqui, nunca no repositório. Vazio desliga o push (o app avisa o dono).
MESAMAR_VAPID_PUBLIC_KEY=
MESAMAR_VAPID_PRIVATE_KEY=
# Contato do servidor para o serviço de push (mailto: ou https:). Vazio usa MESAMAR_PUBLIC_URL.
MESAMAR_VAPID_SUBJECT=

MESAMAR_ADMIN_USER=admin
MESAMAR_ADMIN_PASSWORD=troque-por-uma-senha-longa

# E-mail do painel (link de troca de senha). Sem SPRING_MAIL_HOST, o e-mail não sai:
# o link só aparece no log local quando MESAMAR_MAIL_LOGAR_CORPO=true.
# Em produção, SMTP completo é obrigatório e o envio acontece após o commit.
MESAMAR_MAIL_FROM=MesaMar <nao-responda@0mega.fun>
# Só para desenvolvimento: com "true", o e-mail sem SMTP (com o link de troca de senha) vai inteiro para o log.
# Em produção deixe fora (padrão "false"): o link é uma credencial e não pode ficar em log.
# MESAMAR_MAIL_LOGAR_CORPO=true
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Operação: valores lidos pela extensão x-operacao do mesmo Compose/.env.
MESAMAR_BACKUP_DIR=/opt/mesamar/backups
MESAMAR_BACKUP_DIAS=14
MESAMAR_RPO_SEGUNDOS=86400
MESAMAR_RTO_SEGUNDOS=7200
# S3 externo HTTPS, criptografado com Restic. Inicialize o repositório uma vez.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/opt/mesamar/segredos/restic-password
# JSON fora do git: {"accessKeyId":"...","secretAccessKey":"..."}
MESAMAR_AWS_ARQUIVO=/opt/mesamar/segredos/s3.json
MESAMAR_LGPD_REGISTRO=/opt/mesamar/lgpd/exclusoes.txt
# Monitor externo de ausência de backup, com prazo de 24h.
MESAMAR_BACKUP_PING_URL=
# Sinais independentes do monitor; configure dois checks distintos, fora da VPS.
MESAMAR_DISPONIBILIDADE_PING_URL=
MESAMAR_BACKUP_MONITOR_PING_URL=
MESAMAR_BACKUP_TOLERANCIA_SEGUNDOS=0
