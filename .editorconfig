root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 140
ktlint_code_style = ktlint_official
# Nomes de teste em linguagem natural com crases são o padrão do projeto.
ktlint_function_naming_ignore_when_annotated_with = Test,ParameterizedTest

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
