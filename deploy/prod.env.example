# Copie para /opt/mesamar/.env na VPS e preencha. NUNCA versione o arquivo preenchido.
# Permissão recomendada: chmod 600 .env

# Imagem imutável do artefato versao-validada.json (preencha antes do deploy)
MESAMAR_IMAGE=

# Banco
DB_NAME=mesamar
DB_USER=mesamar_app
DB_PASSWORD=SUBSTITUA_POR_SEGREDO_UNICO
DB_ADMIN_USER=mesamar_admin
DB_ADMIN_PASSWORD=SUBSTITUA_POR_OUTRO_SEGREDO
DB_MIGRATION_USER=mesamar_migration
DB_MIGRATION_PASSWORD=SUBSTITUA_POR_OUTRO_SEGREDO

# Site
MESAMAR_PUBLIC_URL=https://mesamar.0mega.fun
MESAMAR_WHATSAPP=
MESAMAR_CONTACT_EMAIL=
MESAMAR_CF_ANALYTICS_TOKEN=
MESAMAR_TURNSTILE_SITE_KEY=
MESAMAR_TURNSTILE_SECRET_KEY=

# Painel /admin
# Web Push (avisos de pedido com o app fechado). Gere o par UMA vez, no seu computador:
#   ./gradlew --console=plain -q :backend:gerarVapid
# A chave PRIVADA é segredo: só aqui, nunca no repositório. Vazio desliga o push (o app avisa o dono).
MESAMAR_VAPID_PUBLIC_KEY=
MESAMAR_VAPID_PRIVATE_KEY=
# Contato do servidor para o serviço de push (mailto: ou https:). Vazio usa MESAMAR_PUBLIC_URL.
MESAMAR_VAPID_SUBJECT=

MESAMAR_ADMIN_USER=admin
MESAMAR_ADMIN_PASSWORD=SUBSTITUA_POR_OUTRO_SEGREDO

# Nome da rede Docker em que o container do Nginx está
NGINX_NETWORK=web

# SMTP completo é obrigatório em produção; o corpo nunca vai para logs.
MESAMAR_MAIL_FROM=MesaMar <nao-responda@0mega.fun>
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Retenção de todas as cópias de backup (inclusive externas)
MESAMAR_BACKUP_DIAS=14

# Operação: valores lidos pela extensão x-operacao do mesmo Compose/.env.
MESAMAR_BACKUP_DIR=/opt/mesamar/backups
MESAMAR_RPO_SEGUNDOS=86400
MESAMAR_RTO_SEGUNDOS=7200
# S3 externo HTTPS, criptografado com Restic. Inicialize o repositório uma vez.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/opt/mesamar/segredos/restic-password
# JSON fora do git: {"accessKeyId":"...","secretAccessKey":"..."}
MESAMAR_AWS_ARQUIVO=/opt/mesamar/segredos/s3.json
MESAMAR_LGPD_REGISTRO=/opt/mesamar/lgpd/exclusoes.txt
# Monitor externo de ausência de backup, com prazo de 24h.
MESAMAR_BACKUP_PING_URL=
# Sinais independentes do monitor; configure dois checks distintos, fora da VPS.
MESAMAR_DISPONIBILIDADE_PING_URL=
MESAMAR_BACKUP_MONITOR_PING_URL=
MESAMAR_BACKUP_TOLERANCIA_SEGUNDOS=0
