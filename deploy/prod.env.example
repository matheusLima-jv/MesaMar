# Copie para /opt/mesamar/.env na VPS e preencha. NUNCA versione o arquivo preenchido.
# Permissão recomendada: chmod 600 .env

# Versão da imagem (latest = último merge em main; ou o SHA curto de um commit)
MESAMAR_TAG=latest

# Banco
DB_NAME=mesamar
DB_USER=mesamar
DB_PASSWORD=gere-com-openssl-rand-base64-24

# Site
MESAMAR_PUBLIC_URL=https://mesamar.r4d4r.online
MESAMAR_WHATSAPP=
MESAMAR_CONTACT_EMAIL=
MESAMAR_CF_ANALYTICS_TOKEN=
MESAMAR_TURNSTILE_SITE_KEY=
MESAMAR_TURNSTILE_SECRET_KEY=

# Painel /admin
MESAMAR_ADMIN_USER=admin
MESAMAR_ADMIN_PASSWORD=gere-com-openssl-rand-base64-24

# Nome da rede Docker em que o container do Nginx está
NGINX_NETWORK=web
