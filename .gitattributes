# Finais de linha consistentes em qualquer sistema (inclusive Windows).
# Sem isto, um clone no Windows pode converter o gradlew para CRLF e o build
# dentro do Docker (Linux) falha com "/usr/bin/env: 'sh\r': No such file or directory".
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.woff2 binary
*.jar binary
